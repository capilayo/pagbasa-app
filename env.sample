# ─────────────────────────────────────────────────
# pagbasa-app — Environment Configuration
# ─────────────────────────────────────────────────
# For local dev: copy to .env and fill in values.
# For Code Engine: use --env-from-secret (see README.md).
# NEVER commit .env with real credentials.
# ─────────────────────────────────────────────────

# ── ElevenLabs TTS ────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID_EN=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID_TL=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── IBM Watson TTS (fallback) ─────────────────────
WATSON_TTS_API_KEY=your_watson_api_key_here
WATSON_TTS_URL=https://api.jp-tok.text-to-speech.watson.cloud.ibm.com/instances/YOUR_INSTANCE_ID
WATSON_TTS_VOICE=en-US_EmilyV3Voice
WATSON_TTS_VOICE_TL=en-US_EmilyV3Voice
WATSON_TTS_FORMAT=audio/mp3
